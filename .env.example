# ==============================================================
# CẤU HÌNH HỆ THỐNG NHẬN DIỆN KHUÔN MẶT TẦNG BIÊN (PI 4)
# ==============================================================

# --- 1. CHẾ ĐỘ HOẠT ĐỘNG ---
# Luồng mới luôn bật PAD, xử lý một mặt; ENABLE_PAD cũ không còn được dùng.

# --- 2. CẤU HÌNH WEBCAM & MÔ HÌNH AI ---
# CAMERA_INDEX : Cổng USB Webcam (mặc định 0 cho /dev/video0)
CAMERA_INDEX=0

# MATCH_THRESHOLD : Ngưỡng nhận diện ArcFace (0.35 đến 0.42)
MATCH_THRESHOLD=0.40

# FAS_MODEL_PATH : Đường dẫn model Anti-Spoofing (mặc định: models/R7_SC_100K_crop15.onnx)
FAS_MODEL_PATH=models/R7_SC_100K_crop15.onnx
# FAS_MODEL_PATH=models/R7_SC_FULL_crop15.onnx

# FAS_LOGIT_THRESHOLD : Ngưỡng logit phân định Real/Spoof (pad_score = logits[0] - logits[1])
# --- Nhóm 1: Dành cho Model 100K (R7_SC_100K_crop15.onnx) ---
# FAS_LOGIT_THRESHOLD=-4.2998         # Điểm cắt lý thuyết tối ưu hóa chỉ số lỗi ACER/HTER trên tập benchmark quốc tế CASIA-FASD
# FAS_LOGIT_THRESHOLD=-4.9000       # Thực nghiệm phân tách tối ưu: Real (>= -4.70), Phone (<= -5.09)
FAS_LOGIT_THRESHOLD=-0.3730       # Ngưỡng nghiệm thu kiểm thử trên tập Val15K

# --- Nhóm 2: Dành cho Model FULL (R7_SC_FULL_crop15.onnx) ---
# FAS_LOGIT_THRESHOLD=1.6587        # Chuẩn CASIA TRAIN (tối ưu ACER/HTER cho model FULL)
# FAS_LOGIT_THRESHOLD=4.6626        # Ngưỡng nghiệm thu chính thức trên tập CelebA Test

# --- 3. HC-SR04 + SERVO VỊ TRÍ + 2 LED (BCM) ---
# Không dùng đồng thời ma trận 10 LED cũ: GPIO23/24/18 được tái sử dụng.
ULTRASONIC_TRIGGER_PIN=23
ULTRASONIC_ECHO_PIN=24
SERVO_PIN=18
LED_GREEN_PIN=17
LED_RED_PIN=27

# Chỉ cần có echo hợp lệ trong tầm cảm biến; bỏ điều kiện 60/80 cm cũ.
# 400 cm là giới hạn tầm đo, không phải yêu cầu người phải đứng gần.
OBSTACLE_MAX_DISTANCE_CM=400
OBSTACLE_GRACE_SECONDS=2
ULTRASONIC_TIMEOUT_SECONDS=0.03
SENSOR_POLL_SECONDS=0.1

# Servo vị trí 0..180 độ (không dùng servo quay liên tục).
# Sau xác thực: về 0 -> 90 độ, giữ 5 giây -> về 0 -> ngắt PWM.
SERVO_HOME_ANGLE=0
SERVO_OPEN_ANGLE=90
SERVO_HOLD_SECONDS=5
SERVO_RETURN_HOME=true
SERVO_MOVE_SECONDS=0.5
# Hai xung này ứng với hai đầu dải góc đang dùng (mặc định 0 và 90), không phải 0..180.
# Hiệu chỉnh bằng: python -m peripherals.servo_calibrate
SERVO_MIN_PULSE_SECONDS=0.001
SERVO_MAX_PULSE_SECONDS=0.002

# Cần 3 kết quả PAD thật liên tiếp, rồi 3 lần khớp cùng một tên.
PAD_REAL_CONFIRMATIONS=3
MATCH_CONFIRMATIONS=3
